{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/**", "server/**"]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/index.js" },
    { "src": "/(.*\\.(js|css|html|png|jpg|svg|ico|woff|woff2))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "server/index.js" }
  ]
}
